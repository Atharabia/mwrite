# Copy to .env and fill in real values. .env is git-ignored.

# MySQL
MYSQL_DATABASE=mwrite
MYSQL_USER=mwrite
MYSQL_PASSWORD=mwrite
MYSQL_ROOT_PASSWORD=mwrite

# App secrets
JWT_SECRET_KEY=mwrite
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Domain & TLS (Caddy)
# Set DOMAIN to your real domain (DNS must point to this server) to get
# an automatic Let's Encrypt certificate. Leave as "localhost" for local
# development (Caddy will use a self-signed cert).
DOMAIN=localhost
ACME_EMAIL=admin@example.com
